# Copy to terraform.tfvars (gitignored) for local runs. The GitHub workflows
# pass the values they need as TF_VAR_* instead. This file holds no secrets.

aws_region         = "ap-south-1"
cluster_name       = "moneymaker-prod"
vpc_cidr           = "10.40.0.0/16"
availability_zones = ["ap-south-1a", "ap-south-1b", "ap-south-1c"]

node_instance_types = ["t3.xlarge"]
node_desired_size   = 3
node_min_size       = 2
node_max_size       = 6

domain_name        = "algo.mrcobra.link"
route53_zone_name  = "mrcobra.link"
kubernetes_version = "1.34"

# Who may run kubectl against the cluster. The workflows add AWS_ROLE_ARN.
cluster_admin_arns = [
  # "arn:aws:iam::123456789012:role/moneymaker-github-actions",
  # "arn:aws:iam::123456789012:user/your-user",
]
