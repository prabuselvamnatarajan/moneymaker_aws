MONGO_URI=mongodb://localhost:27017
APP_INIT_DB=appInit

DB_LIVE_STRATEGYCHOOSER=strategyChooser
REDIS_LIVE_STRATEGYCHOOSER={"key":"strategyChooserKey","data_type":"json"}
REDIS_URL=redis://localhost:6379
PROPERTY_LIVE_STRATEGYCHOOSER=propertyName

DB_LIVE_WEBSOCKETLISTENING=webSocketListening
